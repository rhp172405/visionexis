# VISIONEXIS Backend Environment Configuration
# Localhost Default: If DATABASE_URL is not set and ENVIRONMENT is development, falls back to sqlite:///eyecog.db

# Environment Mode: 'development' (default), 'staging', or 'production'
# In 'staging' and 'production', SQLite fallback is strictly blocked and DATABASE_URL is required.
ENVIRONMENT=development

# Database Connection (Required for staging and production)
# PostgreSQL connection URL (e.g. Render / Supabase / Neon connection string)
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME or postgresql+pg8000://USER:PASSWORD@HOST:5432/DBNAME
# Note: URL-encode special characters in password (e.g., @ -> %40)
DATABASE_URL=postgresql://user:password@hostname:5432/eyecog

# CORS Allowed Origins (Comma-separated exact origins, NO wildcards allowed)
# Include local dev origins and exact Vercel production and staging preview URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://visionexis.vercel.app

# Server Port (Hosting platforms dynamically set PORT, defaults to 8001 locally)
PORT=8001

# Demo Patient Seeding (Defaults to false in staging/production/test, true in development)
SEED_DEMO_DATA=false

# Authentication & Access Control (Required for cloud staging and production)
# In staging and production, AUTH_REQUIRED defaults to true to block unauthenticated access.
AUTH_REQUIRED=true
# Operator/Clinician API Key used for administration, patient management, dashboard, and exports
OPERATOR_API_KEY=replace-with-a-cryptographically-secure-random-operator-key-min-32-chars
# Cryptographic secret used to HMAC-SHA256 sign participant session JWTs (minimum 32 characters)
AUTH_SECRET_KEY=replace-with-a-cryptographically-secure-random-session-signing-secret-key

