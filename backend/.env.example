# VISIONEXIS Backend Environment Configuration
# Localhost Default: If DATABASE_URL is not set, the backend falls back to sqlite:///eyecog.db

# Production Database (Render PostgreSQL internal or external connection string)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example: http://localhost:5173,https://visionexis.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,https://visionexis.vercel.app

# Port for HTTP server (Render dynamically sets PORT, defaults to 8000 locally)
PORT=8000

# Whether to seed sample demo patients upon startup (set to false in production)
SEED_DEMO_DATA=false
