# VISIONEXIS Frontend Environment Configuration
# Localhost Default: If VITE_API_URL is unset, Vite dev server proxies /api to http://localhost:8001

# Production Backend API Base URL (Render Web Service public URL, without trailing slash)
# Example: https://visionexis-backend.onrender.com
VITE_API_URL=https://visionexis-backend.onrender.com

# SECURITY CRITICAL: DO NOT place OPERATOR_API_KEY or administrative secrets in VITE_* variables.
# In Vite, all VITE_* environment variables are embedded into client-side JS bundles and visible in DevTools.
# Participant sessions authenticate via cryptographically scoped session tokens received from the API.
# Operator/examiner administrative actions must be authenticated via operator session, not a hardcoded shared browser key.
# VITE_API_KEY is reserved ONLY for optional development sandbox/demo environments.
VITE_API_KEY=


